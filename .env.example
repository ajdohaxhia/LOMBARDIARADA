# LOMBARDIA RADAR — nessun valore reale o segreto in questo file.
# Copia in .env.local SOLO le quattro righe VITE_* per il frontend locale.
# Su Cloudflare Pages: Settings → Variables and Secrets / Environment variables
# → Production. Questi quattro valori sono PUBBLICI e finiscono nel JavaScript.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Supabase → Settings → API Keys → Publishable key (sb_publishable_…)
# oppure Legacy API Keys → anon. Il nome ANON_KEY resta per compatibilità.
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY
# Cloudflare → Turnstile → widget di produzione → Site key (non test key).
VITE_TURNSTILE_SITE_KEY=YOUR_PUBLIC_TURNSTILE_SITE_KEY
# Secondo widget Turnstile, per creare la sessione anonima (token distinto).
VITE_TURNSTILE_AUTH_SITE_KEY=YOUR_PUBLIC_TURNSTILE_AUTH_SITE_KEY
# Secret del secondo widget: SOLO Supabase Authentication → Bot and Abuse
# Protection → CAPTCHA provider Turnstile → Secret key, NON Edge Secrets/Pages.
# AUTH_TURNSTILE_SECRET_KEY=YOUR_AUTH_TURNSTILE_SECRET
# Il nome AUTH_TURNSTILE_SECRET_KEY è letto solo da supabase/config.toml
# per Auth locale: fornirlo nell'ambiente della CLI, mai VITE_* o Git.


# BACKEND: impostare SOLO in Supabase → Edge Functions → Secrets.
# Le righe sono commentate per evitare di copiarle nel frontend/Pages.
# TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_PRODUCTION_SECRET
# APP_ORIGIN=https://YOUR_PROJECT.pages.dev
# TURNSTILE_HOSTNAME=YOUR_PROJECT.pages.dev
# APP_ORIGIN: origine esatta, senza slash finale; HOSTNAME: nessun https://.

# BACKEND: variabili lette dal codice ma già fornite da Supabase hosted.
# Non reimpostarle nella dashboard (prefisso SUPABASE_ riservato).
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=SUPPLIED_AUTOMATICALLY_BY_SUPABASE
# Quest'ultima è privilegiata: MAI VITE_*, MAI Pages, MAI browser o Git.

# SOLO CONFIGURAZIONE DASHBOARD, non lette come variabili dall'app:
# Google OAuth Client ID / Client Secret → Supabase Authentication → Google.
# Cloudflare Pages build environment: NODE_VERSION=22.
